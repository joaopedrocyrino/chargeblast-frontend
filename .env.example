# Copy to `.env.local` when running `npm run dev` natively.

# Public API base URL used by the browser. Leave unset locally: calls then go
# to same-origin /api/v1 and are proxied below. Production sets it at build time,
# e.g. https://api-chargeblast.cyrinosoftware.com/api/v1
# NEXT_PUBLIC_API_URL=

# Where the Next.js server proxies `/api/v1/*` (see next.config.ts).
# Native dev against the dockerised API: http://localhost:4000
# Inside docker compose this is set to http://backend:4000.
BACKEND_INTERNAL_URL=http://localhost:4000

# Base URL Playwright drives (defaults to http://localhost:3000).
E2E_BASE_URL=http://localhost:3000

NEXT_TELEMETRY_DISABLED=1
